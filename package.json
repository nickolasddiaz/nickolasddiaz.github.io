{
  "name": "nickolasddiaz-portfolio",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "formatCheck": "prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "test": "bun run test:unit -- --run",
    "syncTypes": "npx svelte-kit sync",
    "legacyPeersTrue": "npm config set legacy-peer-deps true",
    "legacyPeersFalse": "npm config set legacy-peer-deps false"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.5",
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.31.1",
    "flowbite-svelte-blocks": "^2.1.0",
    "flowbite-svelte-icons": "^3.1.0",
    "flowbite-typography": "^1.0.5",
    "globals": "^17.5.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "shiki": "^4.0.2",
    "super-sitemap": "^2.0.6",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "svelte-youtube-embed": "^0.4.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "dependencies": {
    "@nickolasddiaz/physics-banner": "^1.0.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "flexsearch": "^0.8.212"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app.css"
  }
}
